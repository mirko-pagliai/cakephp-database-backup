{
  "name": "mirko-pagliai/cakephp-database-backup",
  "description": "Database Backup plugin for CakePHP",
  "homepage": "https://github.com/mirko-pagliai/cakephp-database-backup",
  "type": "cakephp-plugin",
  "license": "MIT",
  "authors": [
    {
      "name": "Mirko Pagliai",
      "email": "mirko.pagliai@gmail.com"
    }
  ],
  "require": {
    "php": ">=8.4",
    "cakephp/cakephp": "^5.1",
    "symfony/filesystem": "^6.0|^7.2",
    "symfony/process": "^6.0|^7.1.7"
  },
  "require-dev": {
    "cakedc/cakephp-phpstan": "^4.0",
    "phpunit/phpunit": "^10.5.5 || ^11.1.3 || ^12.1",
    "squizlabs/php_codesniffer": "4.0.0beta1",
    "symfony/finder": "^6.0|^7.2",
    "mockery/mockery": "^1.6"
  },
  "autoload": {
    "psr-4": {
      "DatabaseBackup\\": "src"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "App\\": "tests/test_app/TestApp/",
      "DatabaseBackup\\Test\\": "tests"
    }
  },
  "scripts": {
    "test": "phpunit",
    "test-coverage": "XDEBUG_MODE=coverage phpunit --coverage-html=coverage"
  },
  "config": {
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true
    }
  }
}
