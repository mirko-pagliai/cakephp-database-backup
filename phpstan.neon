includes:
    - vendor/cakedc/cakephp-phpstan/extension.neon

parameters:
    level: 8

    paths:
        - config
        - src
        - tests

    bootstrapFiles:
        - config/bootstrap.php

    ignoreErrors:
        -
            message: '#Call to an undefined method Mockery\\[\w\|\\]+::\w+\(\)\.#'
            path: tests/TestCase